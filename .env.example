# Monad Testnet
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Replace with the deployed DuelArena address. The zero address is a safe placeholder.
NEXT_PUBLIC_DUEL_ARENA_ADDRESS=0x0000000000000000000000000000000000000000

# Envio GraphQL endpoint (local default)
NEXT_PUBLIC_ENVIO_ENDPOINT=http://localhost:8080/v1/graphql

# Privy Authentication & Embedded Wallets
# Get your App ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=replace-with-privy-app-id
PRIVY_APP_SECRET=replace-with-server-side-secret

# Pyth Network Hermes Price Feeds (Server-side isolated)
NEXT_PUBLIC_PYTH_HERMES_ENDPOINT=https://pyth.dourolabs.app/hermes
PYTH_HERMES_API_KEY=

# Duelio House Treasury / Protocol Fee Recipient (Monad Testnet 10143)
NEXT_PUBLIC_HOUSE_TREASURY_ADDRESS=0x5A9798AE1abB0b004a4d46a4dC626f87C7513D23

